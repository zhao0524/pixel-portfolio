# Copy this file to .env.local and fill in the values. Never commit real keys.

# Google Gemini API key, used server-side to answer visitors' questions.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini model to use (defaults to gemini-3.5-flash). Use a Gemini 3.x model;
# the chat sets a "low" thinking level, which older models don't accept.
GEMINI_MODEL=gemini-3.5-flash
